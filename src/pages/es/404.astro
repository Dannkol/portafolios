---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { UI } from "../../components/utils/i18n";

const t = UI.es;
---

<Layout title={`404 — ${t.notFoundTitle}`} lang="es">
  <Header />
  <main class="mx-auto flex max-w-2xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <p class="text-7xl font-bold tracking-tight text-indigo-600 dark:text-indigo-400">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-slate-900 sm:text-3xl dark:text-slate-100">
      {t.notFoundTitle}
    </h1>
    <p class="mt-3 text-base text-slate-600 dark:text-slate-400">{t.notFoundBody}</p>
    <a
      href="/es/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700 active:scale-[.98]"
    >
      {t.goHome}
    </a>
  </main>
</Layout>
