---
import Layout from "../layouts/Layout.astro";
import Sobremi from "../content/posts/sobremi.mdx";
import SobremiEs from "../content/posts/sobremi-es.mdx";
import Header from "../components/Header.astro";
---

<Layout title="Daniel Manosalva — Lead Developer & CV">
  <Header />

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 print:max-w-none print:px-0 print:py-0">
    <!-- Toolbar -->
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4 print:hidden">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
          Curriculum Vitae
        </p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Last updated July 2026
        </p>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="lang-button"
          class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100 focus-visible:outline-none active:scale-[.98] dark:border-slate-700 dark:bg-[#1b1e1c] dark:text-slate-200 dark:hover:bg-slate-800"
          aria-label="Switch CV language"
          title="Switch CV language"
        >
          <span class="iconify text-base" data-icon="tabler:language"></span>
          <span id="lang-label">ES</span>
        </button>
        <button
          id="print-button"
          class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 focus-visible:outline-none active:scale-[.98]"
          aria-label="Print or save this CV as PDF"
        >
          <span class="iconify text-base" data-icon="tdesign:print"></span>
          <span id="print-label">Print / Save PDF</span>
        </button>
      </div>
    </div>

    <!-- CV card -->
    <article
      class="rounded-xl border border-slate-200 bg-white p-8 sm:p-10 dark:border-slate-800 dark:bg-[#1b1e1c] print:rounded-none print:border-0 print:bg-white print:p-0"
    >
      <div id="cv-content">
        <div id="cv-en" lang="en">
          <Sobremi />
        </div>
        <div id="cv-es" lang="es" class="hidden">
          <SobremiEs />
        </div>
      </div>
    </article>
  </main>
</Layout>

<script>
  document.getElementById("print-button")?.addEventListener("click", () => {
    window.print();
  });

  const cvEn = document.getElementById("cv-en");
  const cvEs = document.getElementById("cv-es");
  const langLabel = document.getElementById("lang-label");
  const printLabel = document.getElementById("print-label");
  const LANG_KEY = "cv-lang";

  function applyLang(lang: string) {
    const es = lang === "es";
    cvEn?.classList.toggle("hidden", es);
    cvEs?.classList.toggle("hidden", !es);
    if (langLabel) langLabel.textContent = es ? "EN" : "ES";
    if (printLabel) printLabel.textContent = es ? "Imprimir / Guardar PDF" : "Print / Save PDF";
    document.documentElement.lang = es ? "es" : "en";
  }

  let lang = "en";
  try {
    lang = localStorage.getItem(LANG_KEY) ?? "en";
  } catch {}
  applyLang(lang);

  document.getElementById("lang-button")?.addEventListener("click", () => {
    lang = lang === "es" ? "en" : "es";
    applyLang(lang);
    try {
      localStorage.setItem(LANG_KEY, lang);
    } catch {}
  });
</script>
