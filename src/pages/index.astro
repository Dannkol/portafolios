---
import Layout from "../layouts/Layout.astro";
import Sobremi from "../content/posts/sobremi.mdx";
import Header from "../components/Header.astro";
---

<Layout title="Daniel Manosalva — Lead Developer & CV">
  <Header />

  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 print:max-w-none print:px-0 print:py-0">
    <!-- Toolbar -->
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4 print:hidden">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
          Curriculum Vitae
        </p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Last updated July 2026
        </p>
      </div>
      <button
        id="print-button"
        class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 focus-visible:outline-none active:scale-[.98]"
        aria-label="Print or save this CV as PDF"
      >
        <span class="iconify text-base" data-icon="tdesign:print"></span>
        <span>Print / Save PDF</span>
      </button>
    </div>

    <!-- CV card -->
    <article
      class="rounded-xl border border-slate-200 bg-white p-8 sm:p-10 dark:border-slate-800 dark:bg-[#1b1e1c] print:rounded-none print:border-0 print:bg-white print:p-0"
    >
      <div id="cv-content">
        <Sobremi />
      </div>
    </article>
  </main>
</Layout>

<script>
  document.getElementById("print-button")?.addEventListener("click", () => {
    window.print();
  });
</script>
