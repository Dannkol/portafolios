---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { Icon } from "astro-icon/components";
import { formatDate } from "./utils/i18n";
import { UI, type Lang } from "./utils/i18n";

interface Props {
	lang: Lang;
	posts: any[];
}

const { lang, posts } = Astro.props;
const t = UI[lang];
const titleTag = lang === "es" ? "Blog — Daniel Manosalva" : "Blog — Daniel Manosalva";

// Sort posts by date (newest first)
const sortedPosts = [...posts].sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
const blogBase = lang === "es" ? "/es/blog" : "/blog";
---

<Layout title={titleTag} lang={lang}>
  <Header />

  <main class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10 max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
        {t.blogKicker}
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        {t.blogTitle}
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-400">
        {t.blogIntro}
      </p>
    </header>

    {sortedPosts.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white/50 py-20 text-center dark:border-slate-700 dark:bg-slate-900/50">
        <Icon name="tabler:notebook" width="1em" height="1em" class="mx-auto mb-3 block text-4xl text-slate-400" />
        <p class="text-slate-500 dark:text-slate-400">{t.blogEmpty}</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <article class="group relative flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition-colors duration-200 hover:border-indigo-300 focus-within:ring-2 focus-within:ring-indigo-500 dark:border-slate-800 dark:bg-[#1b1e1c] dark:hover:border-indigo-700">
            <div class="relative aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-800">
              {post.frontmatter.coverImage ? (
                <img
                  src={post.frontmatter.coverImage}
                  alt={`Cover image for ${post.frontmatter.title}`}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-indigo-100 dark:bg-indigo-900">
                  <Icon name="tabler:article" width="1em" height="1em" class="text-4xl text-indigo-600 dark:text-indigo-300" />
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-5">
              <div class="mb-2 flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                {post.frontmatter.date && (
                  <time datetime={post.frontmatter.date}>{formatDate(post.frontmatter.date, lang)}</time>
                )}
                {post.frontmatter.category && (
                  <>
                    <span aria-hidden="true">&bull;</span>
                    <span class="text-indigo-600 dark:text-indigo-400">{post.frontmatter.category}</span>
                  </>
                )}
              </div>

              <h2 class="text-lg font-semibold leading-snug text-slate-900 dark:text-slate-100">
                <a
                  href={`${blogBase}/${post.frontmatter.slug}`}
                  class="outline-none transition-colors after:absolute after:inset-0 group-hover:text-indigo-600 dark:group-hover:text-indigo-400"
                >
                  {post.frontmatter.title}
                </a>
              </h2>

              {post.frontmatter.excerpt && (
                <p class="mt-2 line-clamp-3 text-sm text-slate-600 dark:text-slate-400">
                  {post.frontmatter.excerpt}
                </p>
              )}

              {post.frontmatter.tags && (
                <div class="mt-4 flex flex-wrap gap-2 pt-1">
                  {post.frontmatter.tags.map((tag: string) => (
                    <span class="inline-block rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
