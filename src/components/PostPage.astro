---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { Icon } from "astro-icon/components";
import { UI, type Lang } from "./utils/i18n";
import "../../css/styles.css";

interface Props {
	lang: Lang;
	post: any;
}

const { lang, post } = Astro.props;
const t = UI[lang];
const { Content, frontmatter } = post;
const blogHref = lang === "es" ? "/es/blog" : "/blog";
---

<Layout title={frontmatter.title} description={frontmatter.excerpt} ogImage={frontmatter.coverImage} lang={lang}>
  <Header />
  <main class="post-prose mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <a
      href={blogHref}
      class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition-colors hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400"
    >
      <Icon name="tabler:arrow-left" width="1em" height="1em" class="text-base" />
      {t.backToBlog}
    </a>
    <article><Content /></article>
  </main>
</Layout>
