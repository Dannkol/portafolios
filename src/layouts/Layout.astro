---
import "../styles/global.css";
import { langFromPath, alternatePath, type Lang } from "../components/utils/i18n";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	lang?: Lang;
}

const {
	title,
	description = "Daniel Manosalva — Lead Developer building AI clones, RAG chatbots and full-stack products. CV, projects and blog.",
	ogImage,
} = Astro.props;

// The URL is the source of truth for language (English at root, Spanish under /es).
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const site = Astro.site ?? new URL(Astro.request.url);
// The other-language counterpart of the current path.
const otherPath = alternatePath(Astro.url.pathname);
const enPath = lang === "en" ? Astro.url.pathname : otherPath;
const esPath = lang === "es" ? Astro.url.pathname : otherPath;
// Normalize to a trailing slash (root stays "/") so canonical and hreflang match.
const abs = (p: string) => new URL(p.endsWith("/") ? p : p + "/", site).toString();
const canonical = abs(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
	<head>
		<script is:inline>
			// Set theme before paint to avoid flash. Default: follow system.
			(function () {
				try {
					var t = localStorage.getItem("theme");
					if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) {
						document.documentElement.classList.add("dark");
					}
				} catch (e) {}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f4" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141715" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={abs(enPath)} />
		<link rel="alternate" hreflang="es" href={abs(esPath)} />
		<link rel="alternate" hreflang="x-default" href={abs(enPath)} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="antialiased">
		<noscript><style>#loader { display: none; }</style></noscript>
		<div id="loader" aria-hidden="true"><div class="spinner"></div></div>
		<script is:inline>
			window.addEventListener("load", function () {
				document.body.classList.add("loaded");
			});
		</script>
		<div class="parallax-bg" aria-hidden="true"></div>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		/* Single accent — pastel sage. Used across nav, links, buttons, tags. */
		--accent: 86, 119, 97; /* #567761 */
		--accent-strong: 69, 96, 78; /* #45604e */
		--accent-soft: 227, 235, 229; /* #e3ebe5 */
		--surface: #f6f7f4;
		--surface-dark: #141715;
	}

	html {
		font-family:
			"Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		scroll-behavior: smooth;
		-webkit-text-size-adjust: 100%;
	}

	body {
		color: #0f172a; /* slate-900 */
		margin: 0;
		min-height: 100vh;
	}

	/* Page load animation — plain CSS so it shows before the Tailwind CDN compiles. */
	#loader {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-items: center;
		background-color: var(--surface);
		transition: opacity 0.4s ease, visibility 0.4s ease;
	}
	html.dark #loader {
		background-color: var(--surface-dark);
	}
	body.loaded #loader {
		opacity: 0;
		visibility: hidden;
	}
	#loader .spinner {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 3px solid rgb(var(--accent) / 0.2);
		border-top-color: rgb(var(--accent));
		animation: loader-spin 0.7s linear infinite;
	}
	@keyframes loader-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		#loader .spinner {
			animation: none;
		}
	}

	/* Flat pastel backdrop. ponytail: solid color, no gradients, no parallax. */
	.parallax-bg {
		position: fixed;
		inset: 0;
		z-index: -10;
		pointer-events: none;
		background: var(--surface);
	}

	code,
	pre {
		font-family:
			ui-monospace, "SF Mono", Menlo, Monaco, "Liberation Mono",
			"DejaVu Sans Mono", "Courier New", monospace;
	}

	::selection {
		background-color: rgb(var(--accent) / 0.22);
	}

	/* Consistent, visible keyboard focus everywhere. */
	:focus-visible {
		outline: 2px solid rgb(var(--accent));
		outline-offset: 2px;
		border-radius: 4px;
	}

	html.dark body {
		color: #e2e8f0; /* slate-200 */
	}
	html.dark .parallax-bg {
		background: var(--surface-dark);
	}
	html.dark :focus-visible {
		outline-color: #abc2b1;
	}
</style>
